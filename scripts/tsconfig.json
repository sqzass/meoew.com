{
    // scripts/ is intentionally excluded from the root tsconfig (which only covers src/**/*);
    // this gives the language service node types for the standalone .mts build/dev scripts
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": ["esnext"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "target": "esnext",
        "strict": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["**/*.mts", "**/*.mjs", "**/*.ts"]
}
